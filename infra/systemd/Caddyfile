accounts.almalinux.org {
    @blocked_health {
        path /healthz /readyz
        not remote_ip 127.0.0.1 ::1
    }
    respond @blocked_health 404

    @blocked_scanners {
        path /.env /.git/config /phpinfo.php /vendor/phpunit* /wp-admin /wp-admin/* /wp-login.php /xmlrpc.php
    }
    abort @blocked_scanners

    @cf header CF-Connecting-IP *
    reverse_proxy @cf 127.0.0.1:8001 127.0.0.1:8002 {
        lb_policy least_conn
        lb_try_duration 30s
        lb_try_interval 250ms
        fail_duration 5s
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        header_up sentry-trace {http.request.header.sentry-trace}
        header_up baggage {http.request.header.baggage}
    }

    reverse_proxy 127.0.0.1:8001 127.0.0.1:8002 {
        lb_policy least_conn
        lb_try_duration 30s
        lb_try_interval 250ms
        fail_duration 5s
        header_up X-Forwarded-For {http.request.remote.host}
        header_up sentry-trace {http.request.header.sentry-trace}
        header_up baggage {http.request.header.baggage}
    }
}
