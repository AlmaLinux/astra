[Unit]
Description=Astra Caddy reverse proxy
After=network-online.target astra-app@1.service astra-app@2.service
# Wants=, not Requires=: with Requires=, `systemctl restart astra-app@N` also
# stops and restarts Caddy, taking the whole site down on every deploy.
Wants=network-online.target astra-app@1.service astra-app@2.service

[Service]
StandardOutput=null
StandardError=null
EnvironmentFile=/etc/astra/caddy.env
ExecStartPre=-/usr/bin/podman rm -f astra-caddy
ExecStart=/usr/bin/podman run --rm --name astra-caddy --network host -v /etc/astra/Caddyfile:/etc/caddy/Caddyfile:ro -v /var/lib/caddy:/data --log-driver=journald ${CADDY_IMAGE}
ExecStop=/usr/bin/podman stop -t 10 astra-caddy
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
